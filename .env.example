# Public site URL (Railway custom domain or GitHub Pages)
NEXT_PUBLIC_SITE_URL=https://capital.spherearth.ca

# GitHub Pages project site only (repo: SpherEarth-Inc/Capital.Website)
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/Capital.Website
# NEXT_PUBLIC_SITE_URL=https://spherearth-inc.github.io/Capital.Website

# Future Capital API (separate repo / Railway service)
NEXT_PUBLIC_CAPITAL_API_URL=
CAPITAL_API_BASE_URL=

# Display tax rate for Pre-Assessment fee preview (e.g. 0.13 for Ontario HST)
NEXT_PUBLIC_PRE_ASSESSMENT_TAX_RATE=0.13

# Railway sets PORT automatically
PORT=3000
